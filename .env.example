# 复制成 .env 后按需修改。.env 已被 .gitignore 忽略，不会进仓库。
#
# ⚠️ host 与端口在两种场景下不同，**不可互换**：
#     本地 go run          → localhost:15432   （宿主机上的原生 PostgreSQL）
#     docker compose 的 app → db:5432          （compose 网络里的服务名，已写在 docker-compose.yml）
#
# ⚠️ 端口是 15432 不是 5432：Windows 把 5390–5489 划给了 Hyper-V/WSL2 的网络栈
#     （`netsh int ipv4 show excludedportrange protocol=tcp` 可查），
#     5432 落在里面，bind 会返回 Permission denied 而不是 Address already in use。

MAJSPIRIT_ADDR=:8080

# 本项目采用 M.LEAGUE 公式戦ルール，见 docs/规则集.md
MAJSPIRIT_DATABASE_URL=postgres://majspirit:dondeestaaleksey@localhost:15432/majspirit?sslmode=disable

# 生成方式：openssl rand -hex 32
# ⚠️ 未设置时服务必须**拒绝启动**，不要有内置默认值——那等于没有鉴权。
MAJSPIRIT_JWT_SECRET=change-me-openssl-rand-hex-32
